# Docker Compose can start without this file. The default Compose path creates
# POSTGRES_PASSWORD, ADMIN_MFA_SECRET_KEY, and ADMIN_SETTINGS_ENCRYPTION_KEY in
# the persistent postgram_secrets Docker volume. Use this file only for
# explicit overrides.

# Optional Postgres password override. If an existing Docker install has
# POSTGRES_PASSWORD in .env, the first start after this change copies it into
# the Docker-managed secret volume instead of generating a new database password.
# For an external Compose Postgres host, set this to that cluster's password.
# If POSTGRES_HOST is overridden away from the bundled `postgres` service,
# leaving this blank makes mcp-server build a passwordless connection URL.
POSTGRES_PASSWORD=

# Host ports for Docker Compose.
POSTGRAM_API_PORT=3100
UI_PORT=3000

# Admin MFA seed encryption override. Leave blank to use the Docker-managed
# secret file. If set, use a stable 32+ character random value.
ADMIN_MFA_SECRET_KEY=

# OpenAI (conditionally required)
# Required when EMBEDDING_PROVIDER=openai OR (EXTRACTION_ENABLED=true AND EXTRACTION_PROVIDER=openai).
# Docker Compose keeps OpenAI when this key is present; otherwise the entrypoint
# chooses local Ollama embeddings so a clean stack can boot before provider
# secrets are configured.
# Optional otherwise.
OPENAI_API_KEY=sk-...

# Admin settings secret store override. Leave blank to use the Docker-managed
# secret file. Required before saving provider secrets through the admin config
# UI. Keep this outside database backups. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SETTINGS_ENCRYPTION_KEY=

# LLM extraction (knowledge graph)
ANTHROPIC_API_KEY=
EXTRACTION_MEMORY_MODE=embed_only
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# For OpenAI-compatible local or hosted chat-completions APIs, use:
# EXTRACTION_PROVIDER=openai-compatible
# EXTRACTION_BASE_URL=http://host.docker.internal:8000/v1
# EXTRACTION_API_KEY=...
# LLM_REQUEST_TIMEOUT_MS=120000  # hard cap per LLM call; default 120s
# EXTRACTION_DISABLE_THINKING=true  # default true — sends reasoning-off hints
#   (think:false + /no_think + chat_template_kwargs.enable_thinking:false to
#    Ollama, reasoning_effort:minimal to OpenAI). Set to false if a model
#    reacts badly to those hints.
# EXTRACTION_REASONING_EFFORT=  # minimal | low | medium | high
#   Forwarded as `reasoning_effort` to OpenAI and Ollama. Use this for
#   OpenAI-style reasoning models (o-series, gpt-5, gpt-oss) where you want
#   some reasoning budget but not the maximum. Overrides the implicit
#   'minimal' that EXTRACTION_DISABLE_THINKING sends to OpenAI.

# Embeddings
# EMBEDDING_PROVIDER: openai | ollama (default: openai)
# EMBEDDING_MODEL: override the per-provider default
#   - openai default: text-embedding-3-small (1536 dims)
#   - ollama default: bge-m3 (1024 dims)
# EMBEDDING_DIMENSIONS: must match the active embedding_models row; run
#   `pgm-admin embeddings migrate --target-dimensions <N> --yes` to change.
# EMBEDDING_BASE_URL: embedding host when EMBEDDING_PROVIDER=ollama.
#   Independent from OLLAMA_BASE_URL (which is used for LLM extraction).
#   Falls back to OLLAMA_BASE_URL when unset.
#   If Postgram runs in Docker and Ollama runs on the Docker host, use
#   http://host.docker.internal:11434 instead of http://localhost:11434.
# EMBEDDING_API_KEY: optional bearer token for EMBEDDING_BASE_URL.
# EMBEDDING_TIMEOUT_MS: hard timeout for one embedding provider call
#   (default: 15000).
# QUERY_EMBEDDING_CACHE_SIZE: in-process query embeddings cached in front of
#   the Postgres-backed cache (default: 512).
# QUERY_EMBEDDING_CACHE_SECRET: optional HMAC key for the query digest. Cache
#   entries are always partitioned per client and never store query text, but
#   without this key the digest is an unkeyed sha256 that a reader of the
#   database can dictionary-test against guessed queries. Changing it
#   invalidates existing cache rows (they simply miss and are re-embedded).
# QUERY_EMBEDDING_CACHE_RETENTION_DAYS: age at which persisted query
#   embeddings are pruned (default: 30).
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_MS=15000
# QUERY_EMBEDDING_CACHE_SIZE=512
# QUERY_EMBEDDING_CACHE_SECRET=
# QUERY_EMBEDDING_CACHE_RETENTION_DAYS=30

# --- Jev shadow retrieval judge (experiment; dark by default) ---------------
# JEV_SHADOW_ENABLED: when true, each hybrid search also asks the TypeSafe
#   (Jev) API three semantic questions per result candidate (relevant /
#   evidence / contradicts) and records the answers in a `jev.shadow` INFO log
#   event. Judgments NEVER influence results. Costs and latency only appear
#   with the flag on; with it off the SDK is never even imported.
# JEV_API_KEY: required when the flag is on — startup fails config validation
#   without it, so an enabled judge can never silently do nothing.
# PRIVACY: enabling this sends the raw query text and the top candidate chunk
#   contents to api.typesafe.ai per search. The `jev.shadow` event logs only a
#   one-way digest of the query — HMAC-keyed by QUERY_EMBEDDING_CACHE_SECRET
#   and partitioned per client when that client has an id — never plaintext.
# LATENCY: candidates are judged concurrently, so added latency is roughly one
#   JEV_TIMEOUT_MS per search, not per candidate.
# JEV_SHADOW_ENABLED=false
# JEV_API_KEY=
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=3000
# JEV_MAX_CANDIDATES=10

LOG_LEVEL=info

# Server listen port for non-Compose runs. Docker Compose keeps the container
# listen port at 3100 and uses POSTGRAM_API_PORT for the host binding.
PORT=3100

# OAuth for native remote MCP connectors. PUBLIC_BASE_URL must be the public
# HTTPS origin that clients use to reach this server.
# OAUTH_ENABLED=false
# PUBLIC_BASE_URL=https://postgram.example.com

# Docker host binding for the API port. Defaults to 127.0.0.1 (loopback-only
# on the docker host). Set to 0.0.0.0 to expose on the LAN — but prefer a
# reverse proxy (Caddy) with TLS for anything beyond a trusted homelab.
# PORT_BIND_HOST=0.0.0.0

# CLI connection (set these in your shell or ~/.pgmrc)
# PGM_API_URL=http://localhost:3100
# PGM_API_KEY=pgm-local-xxx
