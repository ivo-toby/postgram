{
  "schemaVersion": 1,
  "defaultWorker": "titan-qwen38-pi",
  "workers": {
    "randal-qwen36": {
      "type": "pi",
      "provider": "litellm",
      "model": "randal-mi50/llamacpp/Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf",
      "profile": "randal-qwen38-next-flash-32k-v1",
      "limits": {
        "maxToolCalls": 1000
      }
    },
    "titan-qwen38-pi": {
      "type": "pi",
      "provider": "titan",
      "model": "titan/llamacpp/qwen3.8-pi-q4km-128k",
      "profile": "titan-qwen38-pi-128k-medium-v1",
      "limits": {
        "maxToolCalls": 1000
      }
    }
  },
  "phaseGates": {
    "research": {
      "mode": "human"
    }
  },
  "featureIntegration": {
    "features": {
      "004-report-core": {
        "argv": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "run",
          "tests/integration/workspace-report.feature.test.ts"
        ],
        "dependencyMounts": [
          "node_modules"
        ],
        "testPaths": [
          "tests/integration/workspace-report.feature.test.ts"
        ],
        "entrypoints": [
          "src/services/workspace-service.ts"
        ],
        "timeoutMs": 300000,
        "docker": {
          "socket": "/var/run/docker.sock"
        }
      },
      "004-feature-core": {
        "argv": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "run",
          "tests/integration/feature-service.feature.test.ts"
        ],
        "dependencyMounts": [
          "node_modules"
        ],
        "testPaths": [
          "tests/integration/feature-service.feature.test.ts"
        ],
        "entrypoints": [
          "src/services/feature-service.ts",
          "src/services/task-service.ts"
        ],
        "timeoutMs": 300000,
        "docker": {
          "socket": "/var/run/docker.sock"
        }
      },
      "004-where-api": {
        "argv": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "run",
          "tests/integration/where-service.feature.test.ts",
          "tests/contract/workspace-api.feature.test.ts",
          "tests/contract/workspace-mcp.feature.test.ts"
        ],
        "dependencyMounts": [
          "node_modules"
        ],
        "testPaths": [
          "tests/integration/where-service.feature.test.ts",
          "tests/contract/workspace-api.feature.test.ts",
          "tests/contract/workspace-mcp.feature.test.ts"
        ],
        "entrypoints": [
          "src/index.ts",
          "src/transport/mcp.ts"
        ],
        "timeoutMs": 300000,
        "docker": {
          "socket": "/var/run/docker.sock"
        }
      },
      "004-cli-hooks": {
        "argv": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "run",
          "tests/contract/cli-tracking.feature.test.ts",
          "tests/contract/cli-scan.feature.test.ts"
        ],
        "dependencyMounts": [
          "node_modules"
        ],
        "testPaths": [
          "tests/contract/cli-tracking.feature.test.ts",
          "tests/contract/cli-scan.feature.test.ts"
        ],
        "entrypoints": [
          "cli/src/pgm.ts"
        ],
        "timeoutMs": 600000,
        "docker": {
          "socket": "/var/run/docker.sock"
        }
      }
    }
  }
}
